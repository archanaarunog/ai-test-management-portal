# Copy to .env for local development. Never use these development values in production.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/aitestportal
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development seed account only; rotate/change before any shared deployment.
SEED_DEMO_PASSWORD=Automate@123
