# Local environment overrides for the automation framework.
# These are read by ConfigReader as: System property -> environment variable -> config.properties -> default.
#
# To use this file locally (macOS/Linux):
#   export $(grep -v '^#' .env | xargs)
#   mvn clean test
#
# In GitHub Actions these same values are passed to the test job as `env:` entries
# in .github/workflows/playwright-tests.yml, so this file is for local development only.

BASE_URL=http://localhost:5173
BROWSER=chromium
HEADLESS=true
APP_USERNAME=achu.nair@aitestportal.dev
APP_PASSWORD=Automate@123
